    "labelColor": "#ffffff",
    "outlineColor": "#1f5843",
    "outlineWidth": 0.12,
    "labelCapHeight": 0.34,
    "labelCenterY": 0.47,
    "background": "#1b2330",
    "candidates": [
      { "name": "Titan One", "file": "tools/ui/.cache/fonts/TitanOne-Regular.ttf", "license": "OFL-1.1" },
      { "name": "Lilita One", "file": "tools/ui/.cache/fonts/LilitaOne-Regular.ttf", "license": "OFL-1.1" },
      { "name": "Bagel Fat One", "file": "tools/ui/.cache/fonts/BagelFatOne-Regular.ttf", "license": "OFL-1.1" }
    ]
  }
}
