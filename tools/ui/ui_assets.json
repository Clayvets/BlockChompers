{
  "background": {
    "source": "assets/ui/source/start_screen.jfif",
    "output": "public/assets/ui/start_bg.webp",
    "maxWidth": 1080,
    "quality": 85
  },
  "button": {
    "source": "assets/ui/source/button_green.jfif",
    "output": "public/assets/ui/button_green.png",
    "preview": "tools/ui/preview_button.png",
    "keyThreshold": 20,
    "edgeLumaMax": 140,
    "darkThreshold": 70,
    "supersample": 4,
    "edgeRings": 3,
    "padding": 6,
    "maxWidth": 800,
    "alphaFloor": 5,
    "previewBackgrounds": ["#1b2330", "#f3eee4"],
    "previewWidth": 560,
    "previewZoom": 4,
    "previewZoomBox": 0.3
  },
  "fontPreview": {
    "output": "tools/ui/preview_fonts.png",
